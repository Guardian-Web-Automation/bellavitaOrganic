# Storefront under test (apex host; the store 301-redirects www -> apex).
BASE_URL=https://bellavitaorganic.com/

# Shopify storefront password, if the store is password-gated.
STORE_PASSWORD=

# 2Captcha API key — solves the Cloudflare *Turnstile* interstitial that can gate
# the first page load. (It cannot solve the invisible JS "managed challenge" that
# rate-limits the Shopify AJAX API paths — see README "Anti-bot / Cloudflare".)
TWO_CAPTCHA_API_KEY=

# Optional: Turnstile sitekey fallback if it can't be auto-detected from the
# challenge page (copy data-sitekey from <div class="cf-turnstile" ...>).
CF_TURNSTILE_SITEKEY=

# CI ONLY (GitHub repository secret, not read from .env locally):
# Slack Incoming Webhook URL the CI workflow posts the run summary to.
# SLACK_WEBHOOK_URL=
